# Lead Crawler — example configuration.
#
#   cp .env.example .env
#
# Every value below is optional and shown with its built-in default, except
# LEAD_APOLLO__API_KEY which the apollo source requires. Settings are read from
# the environment with a LEAD_ prefix; nested settings use a double underscore
# (LEAD_<SECTION>__<FIELD>). List values accept either comma-separated text
# (US,CA) or a JSON array (["US","CA"]).
#
# CLI flags override these values for a single run. An omitted flag never
# overrides the environment — that is why the boolean filters have both
# --flag and --no-flag forms.
#
# Secrets belong in this file and nowhere else. Crawler *behaviour* lives in the
# YAML profiles under config/, which never hold a credential.
#
# The LEAD_ prefix is required, and a near-miss is refused rather than ignored:
# `APOLLO_API_KEY=sk-live-...` stops the run and names the variable to use
# instead, because a secret that is silently not read looks exactly like no
# secret at all. The unread spellings include the bare field name
# (LOG_LEVEL), the single-underscore nested form (LEAD_APOLLO_API_KEY) and the
# bare section form (APOLLO_API_KEY).
#
# This file holds no real secrets. Never commit a .env with a live key.

# --- Runtime ---------------------------------------------------------------- #
# LEAD_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
# LEAD_LOG_FORMAT=console          # console | json
# LEAD_MAX_CONCURRENCY=4           # parallel sources per run
# LEAD_DEFAULT_SOURCES=mock        # used when --source is omitted
# LEAD_DEFAULT_LIMIT=100           # raw leads requested from EACH source

# --- Output ----------------------------------------------------------------- #
# Files are named <PREFIX>_<source>_<UTC timestamp>.<ext>, e.g.
#   data/exports/leads_apollo_2026-10-05_14-03-22.csv
# The source component is the run's providers, sorted and hyphen-joined, and the
# timestamp uses "-" in the time because ":" is not legal in a Windows filename.
# Every format of one run shares a stem, with the report as <stem>_report.json.
# The output directory is created if it does not exist.
# LEAD_OUTPUT_DIR=data/exports
# LEAD_OUTPUT_FORMATS=csv,json     # csv | json | jsonl
# LEAD_OUTPUT_PREFIX=leads
# LEAD_OUTPUT_CSV_DELIMITER=,      # use ; for European locales
# LEAD_OUTPUT_ENCODING=utf-8-sig   # UTF-8 with a BOM so Excel detects the encoding
# LEAD_WRITE_RUN_REPORT=true
# LEAD_MAX_RECORDED_REJECTIONS=1000

# --- Processing ------------------------------------------------------------- #
# LEAD_DEDUP_STRATEGY=identity     # none | email | identity | aggressive
# LEAD_DEDUP_MERGE_FIELDS=true
# LEAD_MIN_COMPLETENESS=0.0
# LEAD_SORT_BY_COMPLETENESS=true
# LEAD_HTTP_TIMEOUT=30.0
# LEAD_HTTP_MAX_ATTEMPTS=3
# LEAD_HTTP_INITIAL_BACKOFF=0.5
# LEAD_HTTP_MAX_BACKOFF=20.0

# --- Filters (all opt-in; with defaults nothing is filtered out) ------------ #
# LEAD_FILTERS__REQUIRE_EMAIL=false
# LEAD_FILTERS__REQUIRE_LINKEDIN=false
# LEAD_FILTERS__REQUIRE_COMPANY_DOMAIN=false
# LEAD_FILTERS__EXCLUDE_FREE_EMAIL=false
# LEAD_FILTERS__EXCLUDE_ROLE_BASED_EMAIL=false
# LEAD_FILTERS__INCLUDE_COUNTRIES=US,CA
# LEAD_FILTERS__EXCLUDE_COUNTRIES=
# LEAD_FILTERS__INCLUDE_INDUSTRIES=Software,Information Technology
# LEAD_FILTERS__EXCLUDE_INDUSTRIES=
# LEAD_FILTERS__MIN_EMPLOYEES=50
# LEAD_FILTERS__MAX_EMPLOYEES=
# LEAD_FILTERS__EXCLUDE_DOMAINS=competitor.com
# LEAD_FILTERS__INCLUDE_SENIORITY=c_suite,vp,director
# LEAD_FILTERS__EXCLUDE_SENIORITY=
# Whole-title match, case-insensitive: "CTO" accepts "cto" but not
# "Assistant to the CTO". For substrings use INCLUDE_TITLE_KEYWORDS below.
# LEAD_FILTERS__INCLUDE_TITLES=CTO,VP Engineering
# LEAD_FILTERS__EXCLUDE_TITLES=intern,student
# LEAD_FILTERS__INCLUDE_TITLE_KEYWORDS=
# LEAD_FILTERS__EXCLUDE_TITLE_KEYWORDS=intern,student
# Dotted paths resolved against the lead model. A path that does not exist is a
# configuration error, not a rule that silently never fires.
# LEAD_FILTERS__REQUIRED_FIELDS=company.name,person.email
# LEAD_FILTERS__EXCLUDE_EMAIL_DOMAINS=

# --- Apollo.io (--source apollo) -------------------------------------------- #
# Required for the apollo source. Get one at https://developer.apollo.io/.
LEAD_APOLLO__API_KEY=
# LEAD_APOLLO__BASE_URL=https://api.apollo.io/api/v1
# LEAD_APOLLO__PER_PAGE=25         # 1..100
# LEAD_APOLLO__MAX_PAGES=20        # pagination safety valve, 1..500
# LEAD_APOLLO__PERSON_TITLES=CTO,VP Engineering,Head of Engineering
# Seniorities use Apollo's own vocabulary: owner, founder, c_suite, partner, vp,
# head, director, manager, senior, entry, intern.
# LEAD_APOLLO__PERSON_SENIORITIES=c_suite,vp,head,founder
# LEAD_APOLLO__PERSON_LOCATIONS=Vietnam,Singapore
# LEAD_APOLLO__ORGANIZATION_LOCATIONS=Singapore,Japan,Australia
# LEAD_APOLLO__ORGANIZATION_INDUSTRIES=software,financial services
# Headcount bands. Write them with a hyphen: a comma would be read as the next
# list item in a comma-separated value. JSON arrays may use ["201,500"].
# LEAD_APOLLO__EMPLOYEE_COUNT_RANGES=11-50,201-500
# LEAD_APOLLO__INCLUDE_SIMILAR_TITLES=true
# LEAD_APOLLO__Q_KEYWORDS=

# --- Named profiles (--profile / --search-profile / --filter-profile) -------- #
# A profile is a named acquisition strategy, held as data rather than as flags:
#
#   --profile <name>          the profile of this name in BOTH files below, so
#                             one word selects who to search for and which of
#                             them to keep. A name defined in only one of the two
#                             files applies in only one place.
#   --search-profile <name>   the search half only; wins over --profile.
#   --filter-profile <name>   the qualification half only; wins over --profile.
#   --list-profiles           show every name and the halves it covers.
#
# Precedence, weakest first:
#   LEAD_* environment  <  --profile  <  --search-profile / --filter-profile
#
# Nothing is loaded unless a name is given, so this layer is inert by default.
# A search profile overrides the LEAD_APOLLO__* fields it sets, leaving the rest
# alone. A filter profile is a COMPLETE rule set: naming one REPLACES the
# LEAD_FILTERS__* values above rather than merging with them, so the same profile
# means the same thing on every machine. See config/search_profiles.yaml and
# config/filters.yaml for the formats and the shipped examples.
# LEAD_PROFILE=singapore_tech
# LEAD_SEARCH_PROFILES_PATH=config/search_profiles.yaml
# LEAD_SEARCH_PROFILE=default
# LEAD_FILTER_PROFILES_PATH=config/filters.yaml
# LEAD_FILTER_PROFILE=default

# --- Local CSV (--source csv) ----------------------------------------------- #
# Usually supplied per run with --csv-path instead.
# LEAD_CSV_SOURCE__PATH=samples/leads_sample.csv
# LEAD_CSV_SOURCE__DELIMITER=,     # or "auto" to sniff
# LEAD_CSV_SOURCE__ENCODING=utf-8-sig
# LEAD_CSV_SOURCE__COLUMN_MAP=job_title=Position,company_name=Employer

# --- Company website (--source website) ------------------------------------- #
# Usually supplied per run with --website-url instead. Reads only public pages,
# identifies itself, honours robots.txt and reads at most a few pages per site.
# LEAD_WEBSITE__URLS=acme.com,beta.example
# LEAD_WEBSITE__MAX_PAGES_PER_SITE=3   # 1..10, homepage included
# LEAD_WEBSITE__REQUEST_DELAY=1.0      # seconds between requests to one host
# LEAD_WEBSITE__RESPECT_ROBOTS=true    # turn off only for a site you own
# LEAD_WEBSITE__SAME_HOST_ONLY=true
# LEAD_WEBSITE__MAX_EMAILS=3
# LEAD_WEBSITE__USER_AGENT=TinasoftLeadCrawler/0.1 (+https://tinasoft.example/lead-crawler; contact: data@tinasoft.example)

# --- Mock generator (--source mock) ----------------------------------------- #
# LEAD_MOCK__SEED=1337             # fix for byte-identical output across runs
# LEAD_MOCK__MESSY_RATIO=0.25
# LEAD_MOCK__DUPLICATE_RATIO=0.15
